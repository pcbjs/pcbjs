{
  "name": "@pcbjs/core",
  "version": "0.0.1-beta.0",
  "description": "pcbjs core: the board model, the JSX runtime, the schematic, circuits, variants, the defaults and the site data types.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "src/fonts/SOURCES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "opentype.js": "^2.0.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
