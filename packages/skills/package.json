{
  "name": "@pcbjs/skills",
  "version": "0.1.2",
  "description": "Agent skills for pcbjs in the Agent Skills format: basics, best practices, porting from KiCad and from Python generators, and upgrading. `pcbjs skills install` links them from .agents/skills and .claude/skills.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/skills"
  },
  "homepage": "https://pcbjs.dev",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "pcbjs-basics",
    "pcbjs-best-practices",
    "pcbjs-port-from-kicad",
    "pcbjs-port-from-python-scripted",
    "pcbjs-upgrade"
  ],
  "scripts": {
    "test": "node --import ../../scripts/test-watchdog.mjs --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
