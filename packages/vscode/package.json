        "category": "pcbjs"
      },
      {
        "command": "pcbjs.stop",
        "title": "Detach from the session",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.restart",
        "title": "Attach to the session again",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.restartServer",
        "title": "Restart server",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.restartClean",
        "title": "Restart server and clear caches",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.openInBrowser",
        "title": "Open in browser",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.toggleCursorSync",
        "title": "Toggle cursor sync",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.showOutput",
        "title": "Show output",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.openSessionLog",
        "title": "Open the session log",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.editValue",
        "title": "Edit value",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.icons.associate",
        "title": "Use the pcbjs file icons in Material Icon Theme or vscode-icons",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.icons.revoke",
        "title": "Remove pcbjs file icons",
        "category": "pcbjs"
      },
      {
        "command": "pcbjs.createProject",
        "title": "Create project in workspace",
        "category": "pcbjs",
        "icon": "$(new-folder)"
      },
      {
        "command": "pcbjs.newFromExample",
        "title": "New project from an example",
        "category": "pcbjs",
