{
  "name": "@pcbjs/vscode",
  "version": "0.1.0",
  "private": true,
  "displayName": "pcbjs",
  "description": "Runs the pcbjs dev server for the workspace, previews boards beside the editor, links code and board both ways, and shows the language server of the dev server: hovers, lenses, findings and inline value editors.",
  "type": "commonjs",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/vscode"
  },
  "publisher": "pcbjs",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#0F2219",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "exports": {
    ".": {
      "default": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "test": "npm run build && node --import ../../scripts/test-env.mjs --import ../../scripts/test-watchdog.mjs --test \"tests/*.test.mjs\"",
    "package": "npm run build && node scripts/icon-theme.mjs && node scripts/package.mjs",
    "vscode:prepublish": "npm run build",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "@pcbjs/ts-plugin": "0.1.0"
  },
  "devDependencies": {
    "@pcbjs/core": "0.1.0",
    "@pcbjs/viewer": "0.1.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.90.0",
    "@types/ws": "^8.18.0",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "ws": "^8.18.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-jsonrpc": "^8.2.1"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/pcb.config.*",
    "workspaceContains:node_modules/@pcbjs/pcbjs/package.json",
    "workspaceContains:**/.pcbjs/dev.json",
    "onWebviewPanel:pcbjs.preview"
  ],
  "contributes": {
    "colors": [
      {
        "id": "pcbjs.unitNumber",
        "description": "A number inside a pcbjs coordinate string, such as 9 in at=\"9 7.5\"",
        "defaults": {
          "dark": "#b5cea8",
          "light": "#098658",
          "highContrast": "#b5cea8"
        }
      },
      {
        "id": "pcbjs.unitUnit",
        "description": "A unit inside a pcbjs coordinate string, such as mil in \"100mil\"",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#267f99",
          "highContrast": "#4ec9b0"
        }
      },
      {
        "id": "pcbjs.unitLayer",
        "description": "A layer inside a pcbjs coordinate string, such as B.Cu in \"5 10 B.Cu\"",
        "defaults": {
          "dark": "#c586c0",
          "light": "#af00db",
          "highContrast": "#c586c0"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@pcbjs/ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "commands": [
      {
        "command": "pcbjs.preview",
        "title": "Toggle preview in the last used view",
        "category": "pcbjs",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pcbjs.open2D",
        "title": "Open 2D view",
        "category": "pcbjs",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pcbjs.open3D",
        "title": "Open 3D view",
        "category": "pcbjs",
        "icon": "$(package)"
      },
      {
        "command": "pcbjs.openSchematic",
        "title": "Open schematic view",
        "category": "pcbjs",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "pcbjs.open2DBeside",
        "title": "Open 2D beside",
        "category": "pcbjs",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pcbjs.open3DBeside",
        "title": "Open 3D beside",
        "category": "pcbjs",
        "icon": "$(package)"
      },
      {
        "command": "pcbjs.openSchematicBeside",
        "title": "Open schematic beside",
        "category": "pcbjs",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "pcbjs.open2DNew",
        "title": "Open another 2D view beside",
        "category": "pcbjs",
        "icon": "$(circuit-board)"
      },
      {
        "command": "pcbjs.open3DNew",
        "title": "Open another 3D view beside",
        "category": "pcbjs",
        "icon": "$(package)"
      },
      {
