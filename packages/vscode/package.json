        "category": "pcbjs",
        "enablement": "pcbjs.development",
        "icon": "$(inspect)"
      },
      {
        "command": "pcbjs.devtools.disable",
        "title": "Disable preview dev tools",
        "category": "pcbjs",
        "enablement": "pcbjs.development",
        "icon": "$(inspect)"
      },
      {
        "command": "pcbjs.dev.purgeReload",
        "title": "Purge Reload Dev Suite (dev)",
        "category": "pcbjs",
        "enablement": "pcbjs.development"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pcbjs",
          "title": "PCBJS",
          "icon": "assets/icons/mark-mono.svg"
        }
      ]
    },
    "views": {
      "pcbjs": [
        {
          "id": "pcbjs.boards",
          "name": "Boards"
        },
        {
          "id": "pcbjs.findings",
          "name": "Findings",
          "when": "pcbjs.active"
        },
        {
          "id": "pcbjs.nets",
          "name": "Nets",
          "when": "pcbjs.active",
          "visibility": "collapsed"
        },
        {
          "id": "pcbjs.bom",
          "name": "BOM",
          "when": "pcbjs.active",
          "visibility": "collapsed"
        },
        {
          "id": "pcbjs.agents",
          "name": "Agents",
          "when": "pcbjs.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pcbjs.boards",
        "contents": "The boards of the project appear once its dev server has compiled them.\n[Open 2D view](command:pcbjs.open2D)\n[Open 3D view](command:pcbjs.open3D)\n[Open schematic view](command:pcbjs.openSchematic)",
        "when": "pcbjs.active"
      },
      {
        "view": "pcbjs.boards",
        "contents": "No pcbjs project in this workspace yet. Start a board from the template or the wizard, copy an example, convert a KiCad project, or give your coding agent the pcbjs skills.\n[Create project](command:pcbjs.createProject)\n[New board wizard](command:pcbjs.newBoardWizard)\n[New project from an example](command:pcbjs.newFromExample)\n[Convert from KiCad](command:pcbjs.convertKicad)\n[Install skills](command:pcbjs.installSkills)\nNew to pcbjs? [Open the walkthrough](command:pcbjs.walkthrough).",
        "when": "!pcbjs.active"
      },
      {
        "view": "pcbjs.findings",
        "contents": "No DRC or ERC findings on the boards the dev server shows."
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with pcbjs",
        "description": "Design a PCB as TypeScript and JSX: start a board, see it beside the code, check it and edit it.",
        "featuredFor": [
          "**/pcb.config.{ts,mts,js,mjs}",
          "**/pcb.tsx",
          "**/*.pcb.tsx"
        ],
        "steps": [
          {
            "id": "install",
            "title": "Install pcbjs in the project",
            "description": "The extension runs the pcbjs the project installs, `@pcbjs/pcbjs` in its `node_modules`. This step is checked as soon as it is there, and the status bar shows its version. The install shows the version it is about to install: latest, or with the checkbox the newest of latest, beta and next, then runs `npm install -D` in a terminal.\n[Install pcbjs](command:pcbjs.install)",
            "media": {
              "svg": "assets/walkthrough/install.svg",
              "altText": "The install pick with the version and the dist-tag checkbox, the npm install in a terminal and the version in the status bar."
            },
            "completionEvents": [
              "onContext:pcbjs.installed"
            ]
          },
          {
            "id": "create",
            "title": "Create or open a project",
            "description": "A pcbjs project is a folder with `pcb.tsx` for the board and `pcb.config.ts` listing it. Start one from the template, or let the wizard ask for layers, fab, size and outline, where Enter takes every default. Have one already? [Open its folder](command:workbench.action.files.openFolder).\n[Create project](command:pcbjs.createProject)\n[New board wizard](command:pcbjs.newBoardWizard)",
            "media": {
              "svg": "assets/walkthrough/create.svg",
              "altText": "A new project folder with pcb.tsx, pcb.config.ts, package.json and tsconfig.json."
            },
            "completionEvents": [
              "onCommand:pcbjs.createProject",
              "onCommand:pcbjs.newBoardWizard",
              "onContext:pcbjs.active"
            ]
          },
          {
            "id": "example",
            "title": "Start from an example board",
            "description": "Six boards ship with pcbjs, from a 20 mm coin to a QFN64 breakout. Pick one and it becomes a project of your own with its preview open.\n[New project from an example](command:pcbjs.newFromExample)",
            "media": {
              "svg": "assets/walkthrough/example.svg",
              "altText": "A list of the example boards: blinky, coin, quad, multi, led-matrix and qfn-breakout."
            },
            "completionEvents": [
              "onCommand:pcbjs.newFromExample"
            ]
          },
          {
            "id": "preview",
            "title": "Open the preview beside the code",
            "description": "The 2D, 3D and schematic views follow your edits on every save, and the part under the cursor lights up on the board.\n[Open 2D beside](command:pcbjs.open2DBeside)",
            "media": {
              "svg": "assets/walkthrough/preview.svg",
              "altText": "Code on the left, the board on the right with the part under the cursor outlined."
            },
            "completionEvents": [
              "onCommand:pcbjs.open2DBeside",
              "onCommand:pcbjs.preview",
              "onCommand:pcbjs.openAllViews",
              "onCommand:pcbjs.pickView"
            ]
          },
          {
            "id": "check",
            "title": "Run pcbjs check and read a finding",
            "description": "`pcbjs check` compiles, routes and runs DRC and ERC. Each finding names its rule, the parts and the line of code; the Findings view lists them while the preview runs.\n[Run check](command:pcbjs.check)",
            "media": {
              "svg": "assets/walkthrough/check.svg",
              "altText": "The output of pcbjs check with one silk-over-pad warning and its file and line."
            },
            "completionEvents": [
              "onCommand:pcbjs.check",
              "onView:pcbjs.findings"
            ]
          },
          {
            "id": "edit",
            "title": "Edit a value inline",
            "description": "Values such as a resistance, position or track width open native choices or a validated text input. Accept applies one edit; Escape cancels. Auto-save is controlled by pcbjs.editorAutoSave.\nPut the cursor on a value, then [Edit value](command:pcbjs.editValue)",
            "media": {
              "svg": "assets/walkthrough/edit.svg",
              "altText": "A resistor value edited through native choices and validated text input."
            },
            "completionEvents": [
              "onCommand:pcbjs.editValue"
            ]
          },
          {
            "id": "kicad",
            "title": "Convert from KiCad",
            "description": "`pcbjs import board` turns a KiCad board into `pcb.tsx` with its schematic, copper, footprints and rules, in a new project beside the KiCad one.\n[Convert from KiCad](command:pcbjs.convertKicad)",
            "media": {
              "svg": "assets/walkthrough/kicad.svg",
              "altText": "A KiCad project converted by import board into pcb.tsx."
            },
            "completionEvents": [
              "onCommand:pcbjs.convertKicad"
            ]
          },
          {
            "id": "skills",
            "title": "Install the agent skills",
            "description": "The pcbjs skills teach a coding agent the language, the house rules and the fixes for common findings. `pcbjs skills install` puts them in the project, where the agent finds them.\n[Install skills](command:pcbjs.installSkills)",
            "media": {
              "svg": "assets/walkthrough/skills.svg",
              "altText": "pcbjs skills install with the skills pcbjs-basics, pcbjs-best-practices, pcbjs-port-from-kicad and pcbjs-upgrade."
            },
            "completionEvents": [
              "onCommand:pcbjs.installSkills"
            ]
          }
        ]
      }
    ],
    "iconThemes": [
      {
        "id": "pcbjs",
        "label": "pcbjs",
        "path": "./assets/icon-theme/pcbjs.json",
        "_watch": true
      }
    ],
    "configuration": {
      "title": "pcbjs",
      "properties": {
        "pcbjs.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the dev server when the workspace opens. When off, it starts with the first preview."
        },
        "pcbjs.cursorSync": {
          "type": "boolean",
          "default": true,
          "description": "Send the cursor position to the dev server so the viewer highlights the element under the cursor."
        },
        "pcbjs.followFocus": {
          "type": "boolean",
          "default": true,
          "description": "Tell the dev server which file is active, so the preview shows the board that file belongs to."
        },
        "pcbjs.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "The node binary that runs pcbjs session serve when no session is live. Empty means node from PATH or the usual install locations."
        },
        "pcbjs.editorAutoSave": {
          "type": "boolean",
          "default": true,
          "description": "Save the document after each edit from an inline value editor, so the dev server recompiles and the preview updates."
        },
        "pcbjs.development": {
          "type": "boolean",
          "default": false,
          "description": "Enable preview UI inspection and purge/reload commands for development. Also enabled automatically in an extension development host or the pcbjs source workspace."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "pcbjs.open2DBeside",
          "alt": "pcbjs.open2DNew",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@1"
        },
        {
          "command": "pcbjs.open2DBeside",
          "alt": "pcbjs.open2DNew",
          "when": "pcbjs.active && (resourcePath in pcbjs.entries || resourceFilename == pcb.tsx || resourceFilename =~ /\\.pcb\\.tsx$/)",
          "group": "navigation@1"
        },
        {
          "command": "pcbjs.open3DBeside",
          "alt": "pcbjs.open3DNew",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@2"
        },
        {
          "command": "pcbjs.open3DBeside",
          "alt": "pcbjs.open3DNew",
          "when": "pcbjs.active && (resourcePath in pcbjs.entries || resourceFilename == pcb.tsx || resourceFilename =~ /\\.pcb\\.tsx$/)",
          "group": "navigation@2"
        },
        {
          "command": "pcbjs.openSchematicBeside",
          "alt": "pcbjs.openSchematicNew",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@3"
        },
        {
          "command": "pcbjs.openSchematicBeside",
          "alt": "pcbjs.openSchematicNew",
          "when": "pcbjs.active && (resourcePath in pcbjs.entries || resourceFilename == pcb.tsx || resourceFilename =~ /\\.pcb\\.tsx$/)",
          "group": "navigation@3"
        },
        {
          "command": "pcbjs.openAllViews",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@4"
        },
        {
          "command": "pcbjs.openAllViews",
          "when": "pcbjs.active && (resourcePath in pcbjs.entries || resourceFilename == pcb.tsx || resourceFilename =~ /\\.pcb\\.tsx$/)",
          "group": "navigation@4"
        },
        {
          "command": "pcbjs.preview.reload",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@9"
        },
        {
          "command": "pcbjs.openChecksBeside",
          "alt": "pcbjs.openChecksNew",
          "when": "activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@4"
        },
        {
          "command": "pcbjs.openChecksBeside",
          "alt": "pcbjs.openChecksNew",
          "when": "pcbjs.active && (resourcePath in pcbjs.entries || resourceFilename == pcb.tsx || resourceFilename =~ /\\.pcb\\.tsx$/)",
          "group": "navigation@4"
        },
        {
          "command": "pcbjs.devtools.toggle",
          "when": "pcbjs.development && activeWebviewPanelId == 'pcbjs.preview'",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "pcbjs.editValue",
          "when": "resourceExtname =~ /^\\.tsx?$/ && pcbjs.active",
          "group": "1_modification"
        },
        {
          "command": "pcbjs.sendToAgent",
          "when": "resourceExtname =~ /^\\.tsx?$/ && pcbjs.active",
          "group": "pcbjs@1"
        }
      ],
      "commandPalette": [
        {
          "command": "pcbjs.editValue",
          "when": "editorLangId =~ /^typescript(react)?$/ && pcbjs.active"
        },
        {
          "command": "pcbjs.preview.reload",
          "when": "pcbjs.active"
        },
        {
          "command": "pcbjs.restartClean",
          "when": "pcbjs.active"
        },
        {
          "command": "pcbjs.sidebar.open",
          "when": "false"
        },
