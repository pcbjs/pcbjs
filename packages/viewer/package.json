{
  "name": "@pcbjs/viewer",
  "version": "0.1.2",
  "description": "pcbjs viewer: the app that pcbjs dev serves and pcbjs build prerenders, a shell of routes, top bar and loading screens around the components of @pcbjs/ui, served and built from source by @pcbjs/cli through Vite.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/viewer"
  },
  "exports": {
    "./internal/boot-screen": "./src/boot-screen.js",
    "./internal/boot.css": "./src/boot.css",
    "./internal/mark.svg": "./src/mark.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.html",
    "pane.html",
    "dev3d.html",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "node --import ../../scripts/test-watchdog.mjs --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "@pcbjs/ui": "^0.1.2",
    "three": "^0.182.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "@pcbjs/core": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@pcbjs/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
