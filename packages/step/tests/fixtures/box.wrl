#VRML V2.0 utf8
# A box 2 x 1 x 1 units, raised by 0.5 units, in two shapes that share their points and material: the top and sides, and
# the bottom. KiCad's unit is a tenth of an inch, so the box is 5.08 x 2.54 x 2.54 mm from z 1.27 mm.
WorldInfo { title "box fixture" }
Transform {
  translation 0 0 0.5
  children [
    Shape {
      appearance Appearance { material DEF BODY Material { diffuseColor 0.8 0.6 0.2 } }
      geometry IndexedFaceSet {
        coord DEF PTS Coordinate { point [ -1 -0.5 0, 1 -0.5 0, 1 0.5 0, -1 0.5 0, -1 -0.5 1, 1 -0.5 1, 1 0.5 1, -1 0.5 1 ] }
        coordIndex [ 4, 5, 6, 7, -1, 0, 1, 5, 4, -1, 1, 2, 6, 5, -1, 2, 3, 7, 6, -1, 3, 0, 4, 7, -1 ]
        creaseAngle 0.5
      }
    }
    Shape {
      appearance Appearance { material USE BODY }
      geometry IndexedFaceSet { coord USE PTS coordIndex [ 0, 3, 2, 1, -1 ] }
    }
  ]
}
