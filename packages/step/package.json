{
  "name": "@pcbjs/step",
  "version": "0.0.0",
  "description": "pcbjs step: model files to triangle meshes for the 3D view, STEP through occt-import-js and glTF, GLB and VRML through small readers, in Node, the compact binary form the viewer loads, and the fit of a model to its footprint.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/step"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
