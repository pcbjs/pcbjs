{
  "name": "@pcbjs/cli",
  "version": "0.0.1-beta.1",
  "description": "pcbjs command line: check, build, dev, preview, inspect, shot, docs, ide and create, with the Vite plugin, the editor bridge and the project templates. The pcbjs bin is in @pcbjs/pcbjs.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./test-register": {
      "types": "./dist/test-register.d.ts",
      "default": "./dist/test-register.js"
    },
    "./internal/boards": {
      "types": "./dist/project/boards.d.ts",
      "default": "./dist/project/boards.js"
    },
    "./internal/cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./internal/compile": {
      "types": "./dist/project/compile.d.ts",
      "default": "./dist/project/compile.js"
    },
    "./internal/config": {
      "types": "./dist/project/config.d.ts",
      "default": "./dist/project/config.js"
    },
    "./internal/inspect": {
      "types": "./dist/project/inspect.d.ts",
      "default": "./dist/project/inspect.js"
    },
    "./internal/loader": {
      "types": "./dist/project/loader.d.ts",
      "default": "./dist/project/loader.js"
    },
    "./internal/patch": {
      "types": "./dist/patch.d.ts",
      "default": "./dist/patch.js"
    },
    "./internal/prerender": {
      "types": "./dist/server/prerender.d.ts",
      "default": "./dist/server/prerender.js"
    },
    "./internal/preview": {
      "types": "./dist/project/preview.d.ts",
      "default": "./dist/project/preview.js"
    },
    "./internal/project": {
      "types": "./dist/project/project.d.ts",
      "default": "./dist/project/project.js"
    },
    "./internal/repo": {
      "types": "./dist/project/repo.d.ts",
      "default": "./dist/project/repo.js"
    },
    "./internal/report": {
      "types": "./dist/project/report.d.ts",
      "default": "./dist/project/report.js"
    },
    "./internal/selection": {
      "types": "./dist/session/selection.d.ts",
      "default": "./dist/session/selection.js"
    },
    "./internal/session/serve": {
      "types": "./dist/session/serve.d.ts",
      "default": "./dist/session/serve.js"
    },
    "./internal/shot": {
      "types": "./dist/shot.d.ts",
      "default": "./dist/shot.js"
    },
    "./internal/site": {
      "types": "./dist/server/site.d.ts",
      "default": "./dist/server/site.js"
    },
    "./internal/source-ranges": {
      "types": "./dist/project/source-ranges.d.ts",
      "default": "./dist/project/source-ranges.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "client.d.ts",
    "templates",
    "vscode",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/docs-index.mjs",
    "watch": "tsc -b --watch",
    "test": "node --import ../../scripts/test-env.mjs --import ../../scripts/test-watchdog.mjs --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.0",
    "@pcbjs/compile": "^0.0.1-beta.0",
    "@pcbjs/export": "^0.0.1-beta.1",
    "@pcbjs/fab": "^0.0.1-beta.0",
    "@pcbjs/kicad": "^0.0.1-beta.0",
    "@pcbjs/lib": "^0.0.1-beta.0",
    "@pcbjs/renderer": "^0.1.1",
    "@pcbjs/step": "^0.0.1-beta.0",
    "@pcbjs/ui": "^0.0.1-beta.1",
    "@pcbjs/viewer": "^0.0.1-beta.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "cac": "^7.0.0",
    "esbuild": "^0.28.0",
    "launch-editor": "^2.14.2",
    "magic-string": "^0.30.21",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@pcbjs/core": "^0.0.1-beta.0",
    "@pcbjs/lsp": "^0.0.1-beta.0"
  },
  "peerDependenciesMeta": {
    "@pcbjs/lsp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pcbjs/lsp": "^0.0.1-beta.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
