{
  "name": "@pcbjs/ui",
  "version": "0.1.1",
  "description": "pcbjs UI: the 2D, 3D and schematic views, the selection chip, the findings list and the panels as Vue components, prebuilt, with the viewer store.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view2d": {
      "types": "./dist/entries/view2d.d.ts",
      "default": "./dist/view2d.js"
    },
    "./view3d": {
      "types": "./dist/entries/view3d.d.ts",
      "default": "./dist/view3d.js"
    },
    "./sch": {
      "types": "./dist/entries/sch.d.ts",
      "default": "./dist/sch.js"
    },
    "./checks": {
      "types": "./dist/entries/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./panels": {
      "types": "./dist/entries/panels.d.ts",
      "default": "./dist/panels.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json",
    "test": "node --import ../../scripts/test-watchdog.mjs --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {
    "@pcbjs/core": "^0.1.1"
  },
  "peerDependencies": {
    "@pcbjs/export": "^0.1.1",
    "@pcbjs/step": "^0.1.1",
    "three": ">=0.170.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@pcbjs/export": {
      "optional": true
    },
    "@pcbjs/step": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pcbjs/export": "^0.1.1",
    "@pcbjs/lib": "^0.1.0",
    "@pcbjs/step": "^0.1.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "clipper-lib": "^6.4.2",
    "three": "^0.182.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
