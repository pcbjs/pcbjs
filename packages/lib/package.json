{
  "name": "@pcbjs/lib",
  "version": "0.1.0",
  "description": "pcbjs standard library: footprints, parts, values, fab rule sets, stackups and trace impedance.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://pcbjs.dev",
  "bugs": {
    "url": "https://github.com/pcbjs/pcbjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcbjs/pcbjs.git",
    "directory": "packages/lib"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./stackups": {
      "types": "./dist/stackups.d.ts",
      "default": "./dist/stackups.js"
    },
    "./impedance": {
      "types": "./dist/impedance.d.ts",
      "default": "./dist/impedance.js"
    },
    "./internal/headers": {
      "types": "./dist/headers.d.ts",
      "default": "./dist/headers.js"
    },
    "./internal/passives": {
      "types": "./dist/passives.d.ts",
      "default": "./dist/passives.js"
    },
    "./internal/values": {
      "types": "./dist/values.d.ts",
      "default": "./dist/values.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "LICENSES.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "node --import ../../scripts/test-env.mjs --import ../../scripts/test-watchdog.mjs --test \"tests/**/*.test.mjs\"",
    "prepack": "node ../../scripts/pack-files.mjs pre",
    "postpack": "node ../../scripts/pack-files.mjs post"
  },
  "dependencies": {},
  "peerDependencies": {
    "@pcbjs/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
